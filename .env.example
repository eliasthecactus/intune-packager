# ---------------------------------------------------------------------------
# AI provider: "openrouter" or "foundry"
# ---------------------------------------------------------------------------
LLM_PROVIDER=openrouter

# --- OpenRouter -------------------------------------------------------------
OPENROUTER_API_KEY=
# any OpenRouter model with tool calling, e.g. deepseek/deepseek-v4.1-flash, anthropic/claude-sonnet-5.5, anthropic/claude-opus-5.5
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# --- Microsoft Foundry ------------------------------------------------------
# Either the resource name (https://<name>.services.ai.azure.com) ...
FOUNDRY_RESOURCE=
# ... or a full endpoint URL (overrides the resource name), e.g.
#   https://my-res.services.ai.azure.com            (Claude or OpenAI models)
#   https://my-res.openai.azure.com/openai/v1       (Azure OpenAI v1)
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
# Deployment name. With FOUNDRY_API_STYLE=auto:
#   claude-*                  -> Anthropic Messages API
#   gpt-*, o3/o4-*, codex-*   -> OpenAI Responses API
#   everything else           -> chat completions (DeepSeek, Llama, Mistral, Grok, ...)
FOUNDRY_MODEL=claude-opus-5-5
# auto | anthropic | responses | chat
FOUNDRY_API_STYLE=auto
# responses/chat only: api-key | bearer
FOUNDRY_AUTH_HEADER=api-key
# responses/chat only, if your endpoint still needs it (the /openai/v1 path does not)
FOUNDRY_API_VERSION=
# Optional: a second deployed Claude model used when the main model refuses a request
FOUNDRY_FALLBACK_MODEL=

# Claude effort (low | medium | high | xhigh | max). Empty = model default.
CLAUDE_EFFORT=high
# Reasoning effort for OpenAI models on the Responses API (minimal | low | medium | high | xhigh). Empty = model default.
OPENAI_REASONING_EFFORT=
LLM_MAX_TOKENS=16000
AGENT_MAX_STEPS=60

# ---------------------------------------------------------------------------
# Access protection: if set, everyone must enter this key to use the app
# ---------------------------------------------------------------------------
SHARED_KEY=
# auto (secure cookie behind https) | true | false
COOKIE_SECURE=auto

# ---------------------------------------------------------------------------
# Web research. auto = Tavily > Brave > SearXNG > DuckDuckGo (no key, may be rate limited)
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=
DOWNLOAD_MAX_MB=2048
# allow the AI to fetch internal/private addresses (off = SSRF protection)
ALLOW_PRIVATE_URLS=false

# ---------------------------------------------------------------------------
# Limits / storage
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=4096
MAX_CONCURRENT_JOBS=2
JOB_TTL_HOURS=24
# DATA_DIR=/data
